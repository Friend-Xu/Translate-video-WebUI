{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://translate-video/schemas/timeline_v3.schema.json",
  "title": "Unified Timeline IR v3.0",
  "description": "统一时间轴 JSON Schema v3.0 (数据结构重设计)。对应 core/runtime/event_model.py 的 Project/Event.to_dict() 输出。每个项目工作目录 01_extract/timeline.json 的结构合约。与 v2.0 的差异: translation 统一为 dict、words 一等字段、新增 lineage/semantic/tts/review 子对象、audio 上移 project 级。",
  "type": "object",
  "required": ["schema_version", "project", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "3.0" },
    "project": {
      "type": "object",
      "required": ["id", "source_video", "source_lang", "target_lang"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source_video": { "type": "string" },
        "source_lang": { "type": "string", "minLength": 2, "maxLength": 10 },
        "target_lang": { "type": "string", "minLength": 2, "maxLength": 10 },
        "created_at": { "type": "string", "format": "date-time" },
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vocals_path": { "type": "string" },
            "bgm_path": { "type": "string" },
            "sample_rate": { "type": "integer", "minimum": 8000 }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/TimelineEvent" }
    },
    "speakers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Speaker" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_duration": { "type": "number", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 0 },
        "speaker_count": { "type": "integer", "minimum": 0 },
        "pipeline_version": { "type": "string" }
      }
    }
  },
  "$defs": {
    "TimelineEvent": {
      "type": "object",
      "required": ["id", "start", "end", "text"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "source": {
          "type": "string",
          "enum": ["asr", "alignment", "manual", "imported"],
          "default": "asr"
        },
        "lineage": { "type": "string", "description": "分裂来源 event id, 初始 = 自身 id" },
        "speaker": { "type": ["string", "null"], "default": null },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "words": {
          "type": "array",
          "items": { "$ref": "#/$defs/Word" }
        },
        "semantic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "embedding_ref": { "type": "string" }
          }
        },
        "translation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string" },
            "engine": { "type": "string" },
            "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "similarity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "ppl_ratio": { "type": ["number", "null"], "minimum": 0 },
            "config": { "type": "object" }
          }
        },
        "tts": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "audio_ref": { "type": "string" },
            "duration": { "type": "number", "minimum": 0 },
            "engine": { "type": "string" },
            "quality_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
            "speed_decision": { "type": "object" },
            "emotion_hint": { "type": "string" },
            "config": { "type": "object" }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review_status": {
              "type": "string",
              "enum": ["pending", "approved", "modified", "flagged"],
              "default": "pending"
            },
            "flags": { "type": "array", "items": { "type": "string" } },
            "gate_decision": { "type": ["string", "null"], "enum": ["A", "B", "C", null] },
            "needs_human_review": { "type": "boolean" },
            "notes": { "type": "string" },
            "config": { "type": "object" }
          }
        }
      }
    },
    "Word": {
      "type": "object",
      "required": ["word", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "word": { "type": "string" },
        "start": { "type": "number" },
        "end": { "type": "number" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "Speaker": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "default": "" },
        "embedding_ref": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#808080" }
      }
    }
  }
}
