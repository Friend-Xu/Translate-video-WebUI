{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://translate-video/schemas/patch_log.schema.json",
  "title": "Patch Log",
  "description": "补丁历史日志的 JSON Schema (v2.0)。位于 04_patch/timeline_patches.json。",
  "type": "object",
  "required": ["schema_version", "patches"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "2.0" },
    "patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/PatchEntry" }
    }
  },
  "$defs": {
    "PatchEntry": {
      "type": "object",
      "required": ["patch_id", "opcode", "targets", "author", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "patch_id": { "type": "string" },
        "opcode": {
          "type": "string",
          "enum": [
            "SET_TRANSLATION", "RETAG_SPEAKER", "RENAME_SPEAKER",
            "MERGE_SPEAKERS", "SPLIT_EVENT", "MOVE_EVENT",
            "ADJUST_ALIGNMENT", "RETRIGGER_TTS"
          ]
        },
        "targets": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "payload": { "type": "object" },
        "reason": { "type": "array", "items": { "type": "string" } },
        "score": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1.0 },
        "parent_version": { "type": "string", "default": "" },
        "idempotency_key": { "type": "string", "default": "" },
        "author": { "type": "string", "enum": ["user", "ai", "system", "imported"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["draft", "applied", "rolled_back", "failed", "conflict"],
          "default": "applied"
        },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
